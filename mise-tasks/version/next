#!/usr/bin/env bash
#MISE description="Print the tag git-cliff derives from the commits since the last release"
#MISE quiet=true

set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

tag="$(git cliff --bumped-version | tail -n 1)"
if [[ ! "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
	printf 'git-cliff returned an unusable version: %s\n' "$tag" >&2
	exit 1
fi
printf '%s\n' "$tag"
