#!/usr/bin/env bash
#MISE description="Set the declared version to a release tag and sync the files derived from it"
#USAGE arg "[tag]" help="Release tag to bump to; defaults to version:next" env="TAG"

set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

tag="${usage_tag:-${1:-}}"
[[ -n "$tag" ]] || tag="$(mise-tasks/version/next)"

mise-tasks/version/write "${tag#v}"
mise-tasks/version/check "$tag"
