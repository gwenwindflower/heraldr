#!/usr/bin/env bash
#MISE description="Print the version Cargo.lock records for the heraldr package"
#MISE quiet=true

set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

awk '
  /^\[\[package\]\]$/ { heraldr = 0; next }
  /^name = "heraldr"$/ { heraldr = 1; next }
  heraldr && /^version = / { sub(/^[^"]*"/, ""); sub(/".*$/, ""); print; exit }
' Cargo.lock
