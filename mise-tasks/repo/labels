#!/usr/bin/env bash
#MISE description="Create or update every label declared in .github/labels.yml"

set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"

# labels.yml is a flat list of {name, color, description} mappings with double-quoted scalars.
awk -F'"' '
	/^- name:/ { name = $2 }
	/^  color:/ { color = $2 }
	/^  description:/ { print name "\t" color "\t" $2 }
' .github/labels.yml | while IFS=$'\t' read -r name color description; do
	gh label create "$name" --repo "$repo" --color "$color" --description "$description" --force
	printf '  ✓ %s\n' "$name"
done
