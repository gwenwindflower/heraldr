#!/usr/bin/env bash
#MISE description="Render the Homebrew formula for a published release from its uploaded checksums"
#USAGE arg "<tag>" help="Published release tag whose assets the formula points at"

set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

tag="${usage_tag:-${1:?release tag required}}"
version="${tag#v}"
name="heraldr"
repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
description="$(gh repo view --json description --jq .description)"
class="$(printf '%s' "$name" | awk -F'[-_]' '{ for (i = 1; i <= NF; i++) printf "%s%s", toupper(substr($i, 1, 1)), substr($i, 2) }')"

checksums="$(mktemp -d "${TMPDIR:-/tmp}/formula.XXXXXX")"
trap 'rm -rf "$checksums"' EXIT
gh release download "$tag" --repo "$repo" --pattern '*.tgz.sha256' --dir "$checksums"

formula="$(cat .github/homebrew/formula.rb.tmpl)"
formula="${formula//%%CLASS%%/$class}"
formula="${formula//%%DESCRIPTION%%/$description}"
formula="${formula//%%REPO%%/$repo}"
formula="${formula//%%VERSION%%/$version}"

for target in aarch64-apple-darwin x86_64-apple-darwin aarch64-unknown-linux-gnu x86_64-unknown-linux-gnu; do
	asset="${name}-${target}-v${version}.tgz"
	sha="$(awk '{ print $1 }' "$checksums/${asset}.sha256")"
	[[ -n "$sha" ]] || {
		printf 'No checksum uploaded for %s\n' "$asset" >&2
		exit 1
	}
	formula="${formula//%%URL:${target}%%/https://github.com/${repo}/releases/download/${tag}/${asset}}"
	formula="${formula//%%SHA:${target}%%/$sha}"
done

mkdir -p dist/Formula
printf '%s\n' "$formula" >"dist/Formula/${name}.rb"
printf 'dist/Formula/%s.rb\n' "$name"
